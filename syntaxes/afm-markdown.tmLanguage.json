        {
          "name": "string.unquoted.afm.value.admonition.negative.markdown",
          "match": "[^\\]\\s][^\\]]*"
        }
      ]
    },
    "neutral-tag-value-patterns": {
      "patterns": [
        {
          "name": "string.quoted.double.afm.value.admonition.neutral.markdown",
