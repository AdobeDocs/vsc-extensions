  "repository": {
    "tag-value-patterns": {
      "patterns": [
        {
          "name": "string.quoted.double.afm.value.markdown",
          "match": "\"[^\"]*\""
        },
        {
          "name": "string.unquoted.afm.value.markdown",
          "match": "[^\\]\\s][^\\]]*"
        }
      ]
    },
    "informative-tag-value-patterns": {
      "patterns": [
        {
          "name": "string.quoted.double.afm.value.admonition.informative.markdown",
