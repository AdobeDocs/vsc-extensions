        "1": {
          "name": "punctuation.definition.afm.blockquote.informative.markdown"
        },
        "2": {
          "name": "punctuation.definition.afm.begin.markdown"
        },
        "3": {
          "name": "keyword.other.afm.admonition.informative.markdown"
        },
        "4": {
          "name": "string.unquoted.afm.value.admonition.informative.markdown"
        },
        "5": {
          "name": "punctuation.definition.afm.end.markdown"
        }
      },
      "while": "^\\s*>",
      "whileCaptures": {
        "0": { "name": "punctuation.definition.afm.blockquote.informative.markdown" }
      },
      "patterns": [
        {
          "include": "#afm-fenced-code-in-admonition-blockquote"
        },
        {
          "match": "^\\s*>([a-zA-Z][\\w-]*)(=)(\"[^\"\\r\\n]*\"|'[^'\\r\\n]*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.afm.markdown" },
            "2": { "name": "punctuation.separator.key-value.afm.markdown" },
            "3": { "name": "string.unquoted.afm.attribute-value.markdown" }
          }
        }
      ]
    },
    "afm-positive-admonition-tag": {
      "name": "meta.afm.tag.markdown",
      "begin": "(\\[!)(TIP|SUCCESS)\\b",
      "beginCaptures": {
        "1": {
