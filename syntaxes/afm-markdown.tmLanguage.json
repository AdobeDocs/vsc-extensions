    "afm-fenced-code-in-admonition-blockquote": {
      "comment": "Fenced code inside > admonitions: body line rule below would flatten the whole line to meta.afm.admonition.body.* and kill language injection.",
      "begin": "^(\\s*>\\s*)(```)([^\\n]*)$",
      "beginCaptures": {
        "2": {
          "name": "markup.fenced_code.block.markdown punctuation.definition.markdown"
        },
        "3": {
          "name": "markup.fenced_code.block.markdown fenced_code.block.language.attributes.markdown"
        }
      },
      "end": "^(\\s*>\\s*)(```)\\s*$",
      "applyEndPatternLast": true,
      "endCaptures": {
        "2": {
          "name": "markup.fenced_code.block.markdown punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "match": "^\\s*>\\s?(.*)$",
          "captures": {
            "1": {
              "name": "meta.embedded.block.markdown",
              "patterns": [
                { "include": "source.json" },
                { "include": "source.js" },
                { "include": "source.ts" },
                { "include": "source.tsx" },
                { "include": "source.python" },
                { "include": "source.shellscript" },
                { "include": "source.yaml" },
                { "include": "text.html.basic" },
                { "include": "source.css" },
                { "include": "source.java" },
                { "include": "source.sql" },
                { "include": "source.xml" },
                { "include": "source.cpp" },
                { "include": "source.cs" }
              ]
            }
          }
        }
      ]
    },
    "afm-informative-admonition-tag": {
      "name": "meta.afm.tag.markdown",
      "begin": "(\\[!)(NOTE|INFO|ADMIN|ADMINISTRATION|AVAILABILITY|PREREQUISITES|CONTEXTUALHELP)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.afm.begin.markdown"
        },
        "2": {
          "name": "keyword.other.afm.admonition.informative.markdown"
        }
      },
      "end": "(\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.afm.end.markdown"
        }
      },
      "patterns": [
        {
          "include": "#informative-tag-value-patterns"
        }
      ]
    },
    "afm-informative-admonition-block": {
      "name": "meta.afm.block.admonition.informative.markdown",
      "begin": "^(\\s*>\\s*)(\\[!)(NOTE|INFO|ADMIN|ADMINISTRATION|AVAILABILITY|PREREQUISITES|CONTEXTUALHELP)\\b([^\\]\\r\\n]*)(\\])",
