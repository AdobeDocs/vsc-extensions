{
  "name": "adobe-markdown-authoring",
  "displayName": "ExL Markdown Authoring",
  "description": "Adobe Preview (dedicated webview), linter validation, and keyboard shortcuts for Adobe Flavored Markdown.",
  "version": "2.3.0",
  "publisher": "AdobeExL",
  "engines": {
    "vscode": "^1.75.0"
  },
  "homepage": "https://github.com/AdobeDocs/vsc-extensions.git",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdobeDocs/vsc-extensions.git"
  },
  "icon": "assets/img/adobe-red-logo.png",
  "license": "Apache-2.0",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "markup.quote.markdown",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.definition.quote.begin.markdown",
            "settings": { "foreground": "#5C6BC0" }
          },
          {
            "scope": [
              "punctuation.definition.afm.begin.markdown",
              "punctuation.definition.afm.end.markdown",
              "punctuation.definition.afm.attributes.begin.markdown",
              "punctuation.definition.afm.attributes.end.markdown",
              "punctuation.definition.afm.video-url.begin.markdown",
              "punctuation.definition.afm.video-url.end.markdown"
            ],
            "settings": { "foreground": "#777777" }
          },
          {
            "scope": "keyword.other.afm.macro.markdown",
            "settings": { "foreground": "#777777", "fontStyle": "" }
          },
          {
            "scope": "string.unquoted.afm.macro.value.markdown",
            "settings": { "foreground": "#B5CEA8" }
          },
          {
            "scope": [
              "punctuation.definition.afm.blockquote.informative.markdown",
              "keyword.other.afm.admonition.informative.markdown",
              "string.quoted.double.afm.value.admonition.informative.markdown",
              "string.unquoted.afm.value.admonition.informative.markdown"
            ],
            "settings": { "foreground": "#1473E6", "fontStyle": "bold" }
          },
          {
            "scope": [
              "punctuation.definition.afm.blockquote.positive.markdown",
              "keyword.other.afm.admonition.positive.markdown",
              "string.quoted.double.afm.value.admonition.positive.markdown",
              "string.unquoted.afm.value.admonition.positive.markdown"
            ],
            "settings": { "foreground": "#268E6C", "fontStyle": "bold" }
          },
          {
            "scope": [
              "punctuation.definition.afm.blockquote.caution.markdown",
              "keyword.other.afm.admonition.caution.markdown",
              "string.quoted.double.afm.value.admonition.caution.markdown",
              "string.unquoted.afm.value.admonition.caution.markdown"
            ],
            "settings": { "foreground": "#E68619", "fontStyle": "bold" }
          },
          {
            "scope": [
              "punctuation.definition.afm.blockquote.negative.markdown",
              "keyword.other.afm.admonition.negative.markdown",
              "string.quoted.double.afm.value.admonition.negative.markdown",
              "string.unquoted.afm.value.admonition.negative.markdown"
            ],
            "settings": { "foreground": "#D7373F", "fontStyle": "bold" }
          },
          {
            "scope": [
              "keyword.other.afm.tag.markdown",
              "string.quoted.double.afm.value.markdown",
              "string.unquoted.afm.value.markdown",
              "string.unquoted.afm.collapsible.title.markdown"
            ],
            "settings": { "foreground": "#5C6BC0" }
          },
          {
            "scope": "keyword.other.afm.collapsible.markdown",
            "settings": { "foreground": "#9256D9", "fontStyle": "bold" }
          },
          {
            "scope": "string.other.link.afm.value.markdown",
            "settings": { "foreground": "#1473E6" }
          },
          {
            "scope": [
              "meta.afm.attributes.markdown",
              "entity.other.attribute-name.afm.markdown",
              "punctuation.separator.key-value.afm.markdown",
              "string.unquoted.afm.attribute-value.markdown"
            ],
            "settings": { "foreground": "#777777" }
          }
        ]
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "exl-ghec",
          "title": "EXL CI Monitor",
          "icon": "./assets/icons/ci-monitor.svg"
        }
      ]
    },
    "views": {
      "exl-ghec": [
        {
          "type": "webview",
          "id": "adobeExl.ghecPanel",
          "name": "Build Monitor",
          "icon": "./assets/icons/ci-monitor.svg"
        }
      ]
    },
    "grammars": [
      {
        "scopeName": "markdown.afm.injection",
        "path": "./syntaxes/afm-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Markdown Authoring",
      "properties": {
        "adobeExl.preview.diagnosticMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When enabled, Adobe Preview posts font/CSS diagnostics to the **Adobe Markdown Authoring** output channel after each load. Reopen the preview after toggling. Combine with **Adobe Preview: Open Webview Developer Tools** to inspect the panel in Chromium DevTools."
        },
        "markdown.replaceSmartQuotes": {
          "type": "boolean",
          "default": true,
          "description": "Replace smart quotes with regular quotes."
        },
        "markdown.icons.bold": {
          "type": "boolean",
          "default": true,
          "description": "Show bold icon in title bar"
        },
        "markdown.icons.italic": {
          "type": "boolean",
          "default": true,
          "description": "Show italic icon in title bar"
        },
        "markdown.icons.strikethrough": {
          "type": "boolean",
          "default": true,
          "description": "Show strikethrough icon in title bar"
        },
        "markdown.icons.bullets": {
          "type": "boolean",
          "default": true,
          "description": "Show bullets icon in title bar"
        },
        "markdown.icons.link": {
          "type": "boolean",
          "default": false,
          "description": "Show link icon in title bar"
        },
        "markdown.icons.image": {
          "type": "boolean",
          "default": false,
          "description": "Show image icon in title bar"
        },
        "markdown.bold.marker": {
          "type": "string",
          "default": "**",
          "description": "Bold marker",
          "enum": [
            "__",
            "**"
          ]
        },
        "markdown.bullets.marker": {
          "type": "string",
          "default": "*",
          "description": "Bullets marker",
          "enum": [
            "-",
            "*",
            "+"
          ]
        },
        "markdown.italics.marker": {
          "type": "string",
          "default": "_",
          "description": "Italics marker",
          "enum": [
            "_",
            "*"
          ]
        },
        "markdown.languages": {
          "type": "array",
          "default": [
            "markdown"
          ],
          "description": "Array of languages for which shortcuts will be available"
        }
      }
    },
    "commands": [
      {
        "command": "adobeExl.openAdobePreview",
        "title": "Adobe Preview",
        "category": "Markdown Authoring",
        "icon": {
          "dark": "./assets/icons/grid_white.svg",
          "light": "./assets/icons/grid_black.svg"
        }
      },
      {
        "command": "adobeExl.openAdobePreviewDeveloperTools",
        "title": "Adobe Preview: Open Webview Developer Tools",
        "category": "Markdown Authoring"
      },
      {
        "command": "md-shortcut.toggleBold",
        "title": "Toggle bold",
        "icon": {
          "dark": "./assets/icons/bold_white.svg",
          "light": "./assets/icons/bold_black.svg"
        },
        "category": "Markdown Shortcuts"
