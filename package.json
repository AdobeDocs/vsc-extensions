          "when": "markdown:enabled && config.markdown.icons.link",
          "group": "navigation@5"
        },
        {
          "command": "md-shortcut.toggleImage",
          "when": "markdown:enabled && config.markdown.icons.image",
          "group": "navigation@6"
        }
      ]
