    "menus": {
      "explorer/context": [
        {
          "command": "adobeExl.openAdobePreview",
          "when": "resourceExtname == '.md'",
          "group": "1_adobe@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "adobeExl.openAdobePreview",
          "when": "markdown:enabled",
          "group": "1_adobe@1"
        }
      ],
      "editor/context": [
        {
          "command": "adobeExl.openAdobePreview",
          "when": "markdown:enabled",
          "group": "1_adobe@1"
        },
