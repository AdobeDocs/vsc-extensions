// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "out": false // set this to true to hide the "out" folder with the compiled JS files
    },
    "search.exclude": {
        "out": true // set this to false to include "out" folder in search results
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "typescript.tsc.autoDetect": "off",
    // Use the workspace TypeScript instead of VS Code's bundled version
    "typescript.tsdk": "node_modules/typescript/lib",
    "markdownlint.customRules": [
        "{adobeexl.adobe-markdown-authoring}/markdownlint-custom-rules/rules.mjs"
    ],
    "markdownlint.config": {
        "line-length": false,
        "AM001": false,
        "AM009": false,
        "AM011": false,
        "AM018": false,
        "AM056": false,
        "MD003": {
            "style": "atx"
        },
        "MD004": {
            "style": "consistent"
        },
        "MD007": {
            "indent": 4
        },
        "MD009": false,
        "MD012": false,
        "MD014": false,
        "MD024": false,
        "MD025": false,
        "MD026": false,
        "MD027": false,
        "MD028": false,
        "MD030": {
            "ul_multi": 3,
            "ol_multi": 2
        },
        "MD033": {
            "allowed_elements": [
                "a",
                "b",
                "br",
                "caption",
                "code",
                "col",
                "colgroup",
                "div",
                "em",
                "I",
                "img",
                "li",
                "ol",
                "p",
                "pre",
                "s",
                "span",
                "strong",
                "sub",
                "sup",
                "table",
                "tbody",
                "td",
                "tfoot",
                "th",
                "thead",
                "tr",
                "u",
                "ul"
            ]
        },
        "MD036": false,
        "MD038": false,
        "MD039": false,
        "MD040": false,
        "MD045": false
    }
}
